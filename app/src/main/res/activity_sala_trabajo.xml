<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sala de Trabajo"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnWord"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:text="Word/docx"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnPdf"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:text="PDF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnExcel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:text="Excel"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnBlocNotas"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:text="Bloc de notas"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnCarpeta"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="12dp"
        android:text="Carpeta"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnPowerpoint"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="PowerPoint"
        android:textSize="16sp" />

</LinearLayout>
